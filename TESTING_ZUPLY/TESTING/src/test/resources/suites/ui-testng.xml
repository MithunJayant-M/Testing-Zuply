    </test>

    <test name="Admin Dashboard UI (TC050-TC069)">
        <classes><class name="com.cts.mfrp.zuply.tests.ui.admin.AdminDashboardUiTests"/></classes>
    </test>

    <test name="Image Upload UI (TC025-TC028)">
        <classes><class name="com.cts.mfrp.zuply.tests.ui.seller.ImageUploadUiTests"/></classes>
    </test>

    <test name="AI Listing UI (TC029-TC038)">
        <classes><class name="com.cts.mfrp.zuply.tests.ui.ai.AIListingUiTests"/></classes>
    </test>

    <test name="Security UI (TC039)">
        <classes><class name="com.cts.mfrp.zuply.tests.ui.admin.SecurityUiTests"/></classes>
    </test>

</suite>
