<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Zuply UI Auth-Only Verify" verbose="1">
    <listeners>
        <listener class-name="com.cts.mfrp.zuply.utils.ExtentReportListener"/>
    </listeners>
    <parameter name="headless" value="false"/>
    <parameter name="report.subdir" value="ui"/>
    <test name="Auth UI verify">
        <classes><class name="com.cts.mfrp.zuply.tests.ui.auth.AuthUiTests"/></classes>
    </test>
</suite>
